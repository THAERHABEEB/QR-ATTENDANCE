generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id          String       @id
  name        String
  attendances Attendance[]
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  week      Int
  timestamp DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, week])
}
